# jobpipe configuration — everything is optional; copy to .env
# The pipeline runs with NO credentials and NO LLM (regex-only fallback).

# --- LLM: pick ONE provider preset ------------------------------------------
# Only gemini is supported by the current llm.py (Google Interactions API,
# which is experimental/Beta). Other presets (ollama, groq, etc.) are defined
# in config.py but not wired into the Gemini-only client.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Working model: gemini-3.8-flash (Google Interactions API — experimental)
LLM_MODEL=gemini-3.8-flash

# Overrides — these always win over the preset:
# LLM_BASE_URL=
# LLM_MODEL=
# LLM_API_KEY=

# auto = probe once and fall back to regex-only | on = require | off = never
LLM_ENABLED=auto
# Rate limit handling — check Google AI Studio for current free-tier limits;
# do not rely on the unverified "15 req/min, 1M tokens/day" claim.
LLM_RATE_LIMIT_THRESHOLD=0.75    # notify when 75% of requests used
LLM_RATE_LIMIT_WINDOW=300        # seconds between rate-limit notifications
LLM_MAX_RETRIES=3                # max retries on 429
LLM_BACKOFF_BASE=2.0             # base backoff seconds (exponential)
# Max tool-loop iterations for `jobpipe agent` (disabled until ported)
AGENT_MAX_TURNS=12

# --- Telegram discovery + alerts (all optional) -----------------------------
# TELEGRAM_API_ID=            # my.telegram.org
# TELEGRAM_API_HASH=
# TELEGRAM_CHANNELS=tech_revolution_world
# TELEGRAM_BOT_TOKEN=         # @BotFather
# TELEGRAM_ALERT_CHAT_ID=


# --- behaviour --------------------------------------------------------------
ALERT_MIN_SCORE=40
DEDUP_FUZZ=82

# --- sending (human-in-the-loop; see RUNBOOK.md) ----------------------------
AUTO_APPLY=false
DRY_RUN=true
AUTO_APPLY_MIN_SCORE=70
DAILY_SEND_LIMIT=10
# SMTP_USER=                  # Gmail App Password, not your login
# SMTP_PASS=

# Identity used in generated application emails (required for sending).
# Replace the placeholder values below with real credentials before sending.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SENDER_NAME="Your Name"
SENDER_EMAIL=

# --- SSL / certificates (macOS) ---------------------------------------------
# If SMTP cert verification fails on macOS, install certifi and point here:
# pip install certifi
# SSL_CERT_FILE=/Library/Frameworks/Python.framework/Versions/3.12/lib/python3.12/site-packages/certifi/cacert.pem
